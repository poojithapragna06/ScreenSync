PORT=3000
MONGODB_URI=mongodb://localhost:27017/screensync

# Long random text that signs the login tokens. start-screensync.bat fills in a
# random one when it creates .env; never share or commit the real value.
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=24h

HEARTBEAT_TIMEOUT_MS=30000
HEARTBEAT_INTERVAL_MS=10000
SYNC_BUFFER_MS=2000

# Only needed while developing with the Vite dev server (npm run dev in frontend).
# When the backend serves the dashboard itself (start-screensync.bat), the
# dashboard is on the same address and this doesn't matter.
CORS_ORIGIN=http://localhost:5173

# Max size per uploaded image/video, in MB
MAX_UPLOAD_MB=500
